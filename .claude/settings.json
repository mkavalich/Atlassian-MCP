{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit(servers/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Edit(config/**)",
      "Edit(*.md)",
      "Edit(*.yml)",
      "Edit(*.yaml)",
      "Edit(*.json)",
      "Edit(*.ts)",
      "Edit(*.js)",
      "Edit(*.py)",
      "Edit(*.ps1)",
      "Edit(*.sh)",
      "Edit(Dockerfile*)",
      "Write(servers/**/*.ts)",
      "Write(servers/**/*.js)",
      "Write(servers/**/*.py)",
      "Write(packages/**/*.ts)",
      "Write(packages/**/*.js)",
      "Write(packages/**/*.json)",
      "Write(docs/**)",
      "Write(config/**)",
      "Write(scripts/**)",
      "Write(schemas/**)",
      "Write(*.md)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npm start)",
      "Bash(npm build:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker stop:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker exec:*)",
      "Bash(docker-compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(python:*)",
      "Bash(node:*)",
      "Bash(jest:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(curl:*)",
      "Bash(gh auth:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo create:*)"
    ],
    "deny": [
      "Write(.env)",
      "Edit(.env)",
      "Bash(npm publish:*)",
      "Bash(npm uninstall:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(docker system prune -af)",
      "Bash(docker volume prune -f)"
    ],
    "additionalDirectories": []
  },
  "env": {
    "NODE_ENV": "development",
    "MCP_PROJECT": "atlassian-mcp-servers",
    "COMPOSE_HTTP_TIMEOUT": "1200",
    "DOCKER_BUILDKIT": "1"
  },
  "enableAllProjectMcpServers": true
}
